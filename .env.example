# Configurações do Sistema Casa de Lió
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_PASSWORD=

# Ambiente
ENVIRONMENT=development
PORT=8000

# Armazenamento de Arquivos e Atestados (local ou s3)
STORAGE_TYPE=local
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=casa-de-lio-uploads
S3_REGION=us-east-1
S3_USE_SSL=false
